# ===================================
# Python Git Ignore Template
# ===================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
ENV/
env/
.venv/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# PyTorch, TensorFlow, and model outputs
runs/
logs/
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.tflite

# Environment and dependency files
*.env
*.venv
*.egg-info/
dist/
build/
.eggs/

# Temporary or cache files
*.log
*.tmp
*.bak
*.swp
*.DS_Store
Thumbs.db

# IDE and editor folders
.vscode/
.idea/

# System files
.DS_Store
desktop.ini

# ===================================
# End of .gitignore
# ===================================

